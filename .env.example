# PCController development environment.
#
# Copy to `.env` for this checkout only. Values inherited from the process,
# CI, or a service manager always take precedence over this file. Do not put
# a real token, password, or private-key material in a tracked file.

# Optional explicit configuration file for the Controller executable.
# PCCONTROLLER_CONFIG=C:\ProgramData\PCController\pccontroller.json

# Optional board discovery overrides shared by Go commands and services.
# PCCONTROLLER_DEVICE=COM18
# PCCONTROLLER_PORT=COM18
# PCCONTROLLER_VID=0x0403
# PCCONTROLLER_PID=0x6001
# PCCONTROLLER_NAME=PCController
# PCCONTROLLER_BAUD=115200

# Optional product-presentation overrides used by the build and Web UI.
# APP_NAME=PCController
# APP_TAGLINE=Control your connected workspace

# Optional TUI presentation defaults.
# PCCONTROLLER_TUI_CONSOLE=true
# PCCONTROLLER_TUI_COLUMNS=132
# PCCONTROLLER_TUI_ROWS=40
# PCCONTROLLER_TUI_FONT=Cascadia Mono
# PCCONTROLLER_TUI_FONT_SIZE=14

# Development diagnostics and build inputs.
# PCCONTROLLER_DEBUG=1
# PCCONTROLLER_ARDUINO_CACHE=C:\ProgramData\PCController\arduino-cache
# PCCONTROLLER_BUILD_TIMESTAMP=0x00000000

# Network tools honor standard proxy variables. Local controller traffic is
# still excluded by the runtime's no-proxy policy.
# HTTPS_PROXY=http://proxy.example:8080
# NO_COLOR=1
