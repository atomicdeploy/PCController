file(READ "${PCCONTROLLER_ROOT}/Tools/VirtualBoard/src/native_firmware.cpp" runtime)
file(READ "${PCCONTROLLER_ROOT}/Tools/VirtualBoard/CMakeLists.txt" build)
if(NOT runtime MATCHES "#include \"../../../PCController.ino\"")
  message(FATAL_ERROR "Native runtime must compile the production sketch")
endif()
foreach(source BoardSupportSources.cpp ControllerDomainSources.cpp)
  if(NOT build MATCHES "../../${source}")
    message(FATAL_ERROR "Native target omitted production source aggregator ${source}")
  endif()
endforeach()
foreach(source src/virtual_board.cpp src/hardware.cpp include/virtual_board/hardware.hpp)
  if(EXISTS "${PCCONTROLLER_ROOT}/Tools/VirtualBoard/${source}")
    message(FATAL_ERROR "Independent VirtualBoard implementation returned: ${source}")
  endif()
endforeach()
if(runtime MATCHES "case[ \t]+(Hello|GetStatus|RelaySet|MacroStep|PwmSet)")
  message(FATAL_ERROR "Native wrapper must not acquire an opcode dispatcher")
endif()
